// Local, machine-specific build settings.
//
// Copy this file to Config/Local.xcconfig and fill in your own values:
//
//     cp Config/Local.example.xcconfig Config/Local.xcconfig
//
// Config/Local.xcconfig is gitignored. Never commit it.
// Without it the app still builds, using the defaults in Shared.xcconfig and ad-hoc signing.

// Your Apple Developer Team ID (Xcode > Settings > Accounts), e.g. ABCDE12345.
DEVELOPMENT_TEAM =

// A reverse-DNS bundle identifier you own, e.g. com.yourname.Ripeline.
PRODUCT_BUNDLE_IDENTIFIER = com.example.Ripeline

// Sign with your team. Fill in DEVELOPMENT_TEAM above: this needs it. (Without
// Local.xcconfig the app is signed ad hoc, which is enough to build and test.)
CODE_SIGN_IDENTITY = Apple Development
